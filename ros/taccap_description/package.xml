<?xml version="1.0"?>
<package format="3">
  <name>taccap_description</name>
  <version>0.1.0</version>
  <description>TacCap G1 slave URDF, Xacro, MJCF and USD descriptions.</description>
  <maintainer email="wufan@xenserobotics.com">Xense Robotics</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>urdf</exec_depend>
  <!-- Required by launch/display.launch.py -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
