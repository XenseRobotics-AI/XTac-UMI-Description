<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Mechanical description of the imported simulation baseline, not calibrated hardware limits. -->
  <xacro:macro name="taccap_g1_slave" params="prefix:='' with_mount:=false mesh_root:='package://taccap_description/meshes'">
    <material name="${prefix}taccap_base_mat"><color rgba="0.75294 0.75294 0.75294 1"/></material>
    <material name="${prefix}taccap_left_mat"><color rgba="1 1 1 1"/></material>
    <material name="${prefix}taccap_right_mat"><color rgba="0.60392 0.60392 0.60392 1"/></material>
    <material name="${prefix}taccap_cover_mat"><color rgba="0.89804 0.91765 0.92941 1"/></material>
    <!-- taccap_base_link: gripper mounting face (body/Asm_link mating face). +Z along the tool
         axis, +Y toward the left finger, +X toward the off-axis fingers. Meshes keep their native
         CAD frame (+X tool axis); their placement is the origin below. -->
    <xacro:property name="cad_xyz" value="0.01975 -0.0060769 0.034023"/>
    <xacro:property name="cad_rpy" value="0 ${-pi/2} 0"/>
    <xacro:if value="${with_mount}">
      <!-- Optional adapter; its robot-side face is the root and attaches to the arm flange. -->
      <link name="${prefix}taccap_mount_link">
        <visual name="${prefix}asm_visual">
          <origin xyz="0 0 0" rpy="${cad_rpy}"/>
          <geometry><mesh filename="${mesh_root}/Asm_link.STL"/></geometry>
          <material name="${prefix}taccap_cover_mat"/>
        </visual>
        <collision name="${prefix}asm_collision">
          <origin xyz="0 0 0" rpy="${cad_rpy}"/>
          <geometry><mesh filename="${mesh_root}/Asm_link.STL"/></geometry>
        </collision>
      </link>
      <joint name="${prefix}taccap_mount_joint" type="fixed">
        <parent link="${prefix}taccap_mount_link"/><child link="${prefix}taccap_base_link"/>
        <origin xyz="0 0 0.012" rpy="0 0 0"/>
      </joint>
    </xacro:if>
    <link name="${prefix}taccap_base_link">
      <!-- Simulation-tuned approximation replaces a known CAD mass/inertia unit mismatch.
           Values re-expressed from the native frame: CoM rotated, ixx/izz swapped. -->
      <inertial>
        <origin xyz="0.010155 -0.0007499 0.0361" rpy="0 0 0"/>
        <mass value="0.415"/>
        <inertia ixx="0.000573" iyy="0.000748" izz="0.000680" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual name="${prefix}base_visual">
        <origin xyz="${cad_xyz}" rpy="${cad_rpy}"/>
        <geometry><mesh filename="${mesh_root}/base_link.STL"/></geometry><material name="${prefix}taccap_base_mat"/>
      </visual>
      <collision name="${prefix}base_collision">
        <origin xyz="${cad_xyz}" rpy="${cad_rpy}"/>
        <geometry><mesh filename="${mesh_root}/base_link.STL"/></geometry>
      </collision>
    </link>
    <link name="${prefix}taccap_left_finger_link">
      <inertial>
        <origin xyz="0.020693 -0.00669 0.074921" rpy="0 0 0"/>
        <mass value="0.36678"/>
        <inertia ixx="0.00015235" iyy="0.00015466" izz="3.3606e-05" ixy="2.9254e-07" ixz="-2.4362e-06" iyz="-6.6715e-06"/>
      </inertial>
      <visual name="${prefix}left_finger_visual">
        <origin xyz="0 0 0" rpy="${cad_rpy}"/>
        <geometry><mesh filename="${mesh_root}/grip_left.STL"/></geometry><material name="${prefix}taccap_left_mat"/>
      </visual>
      <collision name="${prefix}left_finger_collision"><origin xyz="0 0 0" rpy="${cad_rpy}"/><geometry><mesh filename="${mesh_root}/grip_left.STL"/></geometry></collision>
    </link>
    <!-- Finger frames share the base axes; meshes use the native CAD placement and the
         inertials are re-expressed (axis permutation with sign changes, same values).
         The native -Z hinge is +X here; zero, limits and signs are unchanged. -->
    <joint name="${prefix}taccap_left_finger_joint" type="revolute">
      <parent link="${prefix}taccap_base_link"/><child link="${prefix}taccap_left_finger_link"/>
      <origin xyz="0.0120336718 0.0199500106 0.0484999712" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <!-- Effort and velocity are simulation settings; see config/model.json. -->
      <limit lower="-0.5047492196767601" upper="0" effort="4" velocity="1"/>
      <dynamics damping="0.08" friction="0.01"/>
      <mimic joint="${prefix}taccap_right_finger_joint" multiplier="-1" offset="0"/>
    </joint>
    <link name="${prefix}taccap_right_finger_link">
      <inertial>
        <origin xyz="0.020629 0.0066814 0.07491" rpy="0 0 0"/>
        <mass value="0.36678"/>
        <inertia ixx="0.00015238" iyy="0.0001547" izz="3.3592e-05" ixy="-2.9549e-07" ixz="-2.4418e-06" iyz="6.6629e-06"/>
      </inertial>
      <visual name="${prefix}right_finger_visual">
        <origin xyz="0 0 0" rpy="${cad_rpy}"/>
        <geometry><mesh filename="${mesh_root}/grip_right.STL"/></geometry><material name="${prefix}taccap_right_mat"/>
      </visual>
      <collision name="${prefix}right_finger_collision"><origin xyz="0 0 0" rpy="${cad_rpy}"/><geometry><mesh filename="${mesh_root}/grip_right.STL"/></geometry></collision>
    </link>
    <joint name="${prefix}taccap_right_finger_joint" type="revolute">
      <parent link="${prefix}taccap_base_link"/><child link="${prefix}taccap_right_finger_link"/>
      <origin xyz="0.0120336718 -0.0199499894 0.0484999712" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="0" upper="0.5047492196767601" effort="4" velocity="1"/>
      <dynamics damping="0.08" friction="0.01"/>
    </joint>
    <!-- Massless virtual EEF: centre of the closed fingertips' most distal face (mesh-derived,
         shared with the master grippers); same axes as taccap_base_link. -->
    <link name="${prefix}taccap_eef_link"/>
    <joint name="${prefix}taccap_eef_joint" type="fixed">
      <parent link="${prefix}taccap_base_link"/><child link="${prefix}taccap_eef_link"/>
      <origin xyz="0.036575 0 0.2009217" rpy="0 0 0"/>
    </joint>
    <!-- Wrist camera point marked in CAD (A3-从夹爪组件.SLDASM, 2026-10-09 measurement from the
         taccap_base_link origin: 22.75 mm toward -X, 0 in Y, 61.25 mm along the tool axis). It lies on
         the dome-window axis, 19.95 mm behind the window ring. Not a calibration. Same axes as
         taccap_base_link: +Z along the optical (tool) axis, +Y left finger, +X toward the fingers. -->
    <link name="${prefix}taccap_camera_link"/>
    <joint name="${prefix}taccap_camera_joint" type="fixed">
      <parent link="${prefix}taccap_base_link"/><child link="${prefix}taccap_camera_link"/>
      <origin xyz="-0.02275 0 0.06125" rpy="0 0 0"/>
    </joint>
    <!-- Optical frame (REP-103): +Z optical axis, +X image right, +Y image down toward the fingers. -->
    <link name="${prefix}taccap_camera_optical_link"/>
    <joint name="${prefix}taccap_camera_optical_joint" type="fixed">
      <parent link="${prefix}taccap_camera_link"/><child link="${prefix}taccap_camera_optical_link"/>
      <origin xyz="0 0 0" rpy="0 0 ${-pi/2}"/>
    </joint>
  </xacro:macro>
</robot>
