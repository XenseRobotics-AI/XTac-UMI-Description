<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Mechanical description of the TacCap G1 slave gripper. -->
  <!-- Maximum output torque (N m) of the finger motor, RobStride EL05; the hardware limits it to
       1.1 N m for continuous stall. MJCF and USD take their force limits from this effort. -->
  <xacro:property name="taccap_finger_effort" value="1.1"/>
  <xacro:macro name="taccap_g1_slave" params="prefix:='' with_mount:=false mesh_root:='package://taccap_description/meshes'">
    <!-- Appearance follows the physical gripper (xensim-bench `Looks/TacCap/*`): silver
         structure, light-grey finger covers, black frame and motor, a dark gel pad, a dark lens
         and yellow only on the fingertips and around the lens. One material per visual, so the
         face partition in config/appearance.json is shipped as separate mesh parts. -->
    <material name="${prefix}taccap_silver"><color rgba="0.58 0.6 0.62 1"/></material>
    <material name="${prefix}taccap_cover"><color rgba="0.65 0.7 0.71 1"/></material>
    <material name="${prefix}taccap_black"><color rgba="0.018 0.02 0.022 1"/></material>
    <material name="${prefix}taccap_yellow"><color rgba="0.95 0.75 0.012 1"/></material>
    <material name="${prefix}taccap_gel"><color rgba="0.055 0.055 0.055 1"/></material>
    <material name="${prefix}taccap_lens"><color rgba="0.004 0.004 0.004 1"/></material>
    <!-- taccap_base_link: gripper mounting face (body/Asm_link mating face). +Z along the tool
         axis, +Y toward the left finger, +X toward the off-axis fingers. Meshes keep their native
         CAD frame (+X tool axis); their placement is the origin below. -->
    <xacro:property name="cad_xyz" value="0.01975 -0.0060769 0.034023"/>
    <xacro:property name="cad_rpy" value="0 ${-pi/2} 0"/>
    <xacro:if value="${with_mount}">
      <!-- Optional adapter; its robot-side face is the root and attaches to the arm flange. -->
      <link name="${prefix}taccap_mount_link">
        <visual name="${prefix}asm_visual">
          <origin xyz="0 0 0" rpy="${cad_rpy}"/>
          <geometry><mesh filename="${mesh_root}/Asm_link.STL"/></geometry>
          <material name="${prefix}taccap_cover"/>
        </visual>
        <collision name="${prefix}asm_collision">
          <origin xyz="0 0 0" rpy="${cad_rpy}"/>
          <geometry><mesh filename="${mesh_root}/Asm_link.STL"/></geometry>
        </collision>
      </link>
      <joint name="${prefix}taccap_mount_joint" type="fixed">
        <parent link="${prefix}taccap_mount_link"/><child link="${prefix}taccap_base_link"/>
        <origin xyz="0 0 0.012" rpy="0 0 0"/>
      </joint>
    </xacro:if>
    <link name="${prefix}taccap_base_link">
      <!-- Body inertial in the base frame. -->
      <inertial>
        <origin xyz="0.010155 -0.0007499 0.0361" rpy="0 0 0"/>
        <mass value="0.415"/>
        <inertia ixx="0.000573" iyy="0.000748" izz="0.000680" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <!-- One visual per material: the body shell is silver, the motor and frame black, the
           lens cap yellow, the optics lens near-black. -->
      <visual name="${prefix}base_visual_silver">
        <origin xyz="${cad_xyz}" rpy="${cad_rpy}"/>
        <geometry><mesh filename="${mesh_root}/base_link__silver.STL"/></geometry><material name="${prefix}taccap_silver"/>
      </visual>
      <visual name="${prefix}base_visual_black">
        <origin xyz="${cad_xyz}" rpy="${cad_rpy}"/>
        <geometry><mesh filename="${mesh_root}/base_link__black.STL"/></geometry><material name="${prefix}taccap_black"/>
      </visual>
      <visual name="${prefix}base_visual_yellow">
        <origin xyz="${cad_xyz}" rpy="${cad_rpy}"/>
        <geometry><mesh filename="${mesh_root}/base_link__yellow.STL"/></geometry><material name="${prefix}taccap_yellow"/>
      </visual>
      <visual name="${prefix}base_visual_lens">
        <origin xyz="${cad_xyz}" rpy="${cad_rpy}"/>
        <geometry><mesh filename="${mesh_root}/base_link__lens.STL"/></geometry><material name="${prefix}taccap_lens"/>
      </visual>
      <collision name="${prefix}base_collision">
        <origin xyz="${cad_xyz}" rpy="${cad_rpy}"/>
        <geometry><mesh filename="${mesh_root}/base_link.STL"/></geometry>
      </collision>
    </link>
    <link name="${prefix}taccap_left_finger_link">
      <inertial>
        <origin xyz="0.020693 -0.00669 0.074921" rpy="0 0 0"/>
        <mass value="0.36678"/>
        <inertia ixx="0.00015235" iyy="0.00015466" izz="3.3606e-05" ixy="2.9254e-07" ixz="-2.4362e-06" iyz="-6.6715e-06"/>
      </inertial>
      <!-- Grey cover, black frame strip and screws, silver hinge block, gel pad, yellow tip. -->
      <visual name="${prefix}left_finger_visual_cover">
        <origin xyz="0 0 0" rpy="${cad_rpy}"/>
        <geometry><mesh filename="${mesh_root}/grip_left__cover.STL"/></geometry><material name="${prefix}taccap_cover"/>
      </visual>
      <visual name="${prefix}left_finger_visual_black">
        <origin xyz="0 0 0" rpy="${cad_rpy}"/>
        <geometry><mesh filename="${mesh_root}/grip_left__black.STL"/></geometry><material name="${prefix}taccap_black"/>
      </visual>
      <visual name="${prefix}left_finger_visual_silver">
        <origin xyz="0 0 0" rpy="${cad_rpy}"/>
        <geometry><mesh filename="${mesh_root}/grip_left__silver.STL"/></geometry><material name="${prefix}taccap_silver"/>
      </visual>
      <visual name="${prefix}left_finger_visual_gel">
        <origin xyz="0 0 0" rpy="${cad_rpy}"/>
        <geometry><mesh filename="${mesh_root}/grip_left__gel.STL"/></geometry><material name="${prefix}taccap_gel"/>
      </visual>
      <visual name="${prefix}left_finger_visual_yellow">
        <origin xyz="0 0 0" rpy="${cad_rpy}"/>
        <geometry><mesh filename="${mesh_root}/grip_left__yellow.STL"/></geometry><material name="${prefix}taccap_yellow"/>
      </visual>
      <collision name="${prefix}left_finger_collision"><origin xyz="0 0 0" rpy="${cad_rpy}"/><geometry><mesh filename="${mesh_root}/grip_left.STL"/></geometry></collision>
    </link>
    <!-- Finger frames share the base axes; meshes use the native CAD placement and the
         hinges rotate about +X. Zero is closed; the right finger drives, the left mimics. -->
    <joint name="${prefix}taccap_left_finger_joint" type="revolute">
      <parent link="${prefix}taccap_base_link"/><child link="${prefix}taccap_left_finger_link"/>
      <origin xyz="0.0120336718 0.0199500106 0.0484999712" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <!-- Effort is the finger motor's maximum output torque; see config/model.json. -->
      <limit lower="-0.5047492196767601" upper="0" effort="${taccap_finger_effort}" velocity="1"/>
      <dynamics damping="0.08" friction="0.01"/>
      <mimic joint="${prefix}taccap_right_finger_joint" multiplier="-1" offset="0"/>
    </joint>
    <link name="${prefix}taccap_right_finger_link">
      <inertial>
        <origin xyz="0.020629 0.0066814 0.07491" rpy="0 0 0"/>
        <mass value="0.36678"/>
        <inertia ixx="0.00015238" iyy="0.0001547" izz="3.3592e-05" ixy="-2.9549e-07" ixz="-2.4418e-06" iyz="6.6629e-06"/>
      </inertial>
      <visual name="${prefix}right_finger_visual_cover">
        <origin xyz="0 0 0" rpy="${cad_rpy}"/>
        <geometry><mesh filename="${mesh_root}/grip_right__cover.STL"/></geometry><material name="${prefix}taccap_cover"/>
      </visual>
      <visual name="${prefix}right_finger_visual_black">
        <origin xyz="0 0 0" rpy="${cad_rpy}"/>
        <geometry><mesh filename="${mesh_root}/grip_right__black.STL"/></geometry><material name="${prefix}taccap_black"/>
      </visual>
      <visual name="${prefix}right_finger_visual_silver">
        <origin xyz="0 0 0" rpy="${cad_rpy}"/>
        <geometry><mesh filename="${mesh_root}/grip_right__silver.STL"/></geometry><material name="${prefix}taccap_silver"/>
      </visual>
      <visual name="${prefix}right_finger_visual_gel">
        <origin xyz="0 0 0" rpy="${cad_rpy}"/>
        <geometry><mesh filename="${mesh_root}/grip_right__gel.STL"/></geometry><material name="${prefix}taccap_gel"/>
      </visual>
      <visual name="${prefix}right_finger_visual_yellow">
        <origin xyz="0 0 0" rpy="${cad_rpy}"/>
        <geometry><mesh filename="${mesh_root}/grip_right__yellow.STL"/></geometry><material name="${prefix}taccap_yellow"/>
      </visual>
      <collision name="${prefix}right_finger_collision"><origin xyz="0 0 0" rpy="${cad_rpy}"/><geometry><mesh filename="${mesh_root}/grip_right.STL"/></geometry></collision>
    </link>
    <joint name="${prefix}taccap_right_finger_joint" type="revolute">
      <parent link="${prefix}taccap_base_link"/><child link="${prefix}taccap_right_finger_link"/>
      <origin xyz="0.0120336718 -0.0199499894 0.0484999712" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="0" upper="0.5047492196767601" effort="${taccap_finger_effort}" velocity="1"/>
      <dynamics damping="0.08" friction="0.01"/>
    </joint>
    <!-- Massless virtual EEF: centre of the closed fingertips' most distal face (mesh-derived,
         shared with the master grippers); same axes as taccap_base_link. -->
    <link name="${prefix}taccap_eef_link"/>
    <joint name="${prefix}taccap_eef_joint" type="fixed">
      <parent link="${prefix}taccap_base_link"/><child link="${prefix}taccap_eef_link"/>
      <origin xyz="0.036575 0 0.2009217" rpy="0 0 0"/>
    </joint>
    <!-- Wrist camera point, from the taccap_base_link origin: 22.75 mm toward -X, 0 in Y,
         61.25 mm along the tool axis. It lies on the dome-window axis, 19.95 mm behind the window
         ring. Same axes as taccap_base_link: +Z along the optical (tool) axis, +Y left finger,
         +X toward the fingers. -->
    <link name="${prefix}taccap_camera_link"/>
    <joint name="${prefix}taccap_camera_joint" type="fixed">
      <parent link="${prefix}taccap_base_link"/><child link="${prefix}taccap_camera_link"/>
      <origin xyz="-0.02275 0 0.06125" rpy="0 0 0"/>
    </joint>
    <!-- Optical frame (REP-103): +Z optical axis, +X image right, +Y image down toward the fingers. -->
    <link name="${prefix}taccap_camera_optical_link"/>
    <joint name="${prefix}taccap_camera_optical_joint" type="fixed">
      <parent link="${prefix}taccap_camera_link"/><child link="${prefix}taccap_camera_optical_link"/>
      <origin xyz="0 0 0" rpy="0 0 ${-pi/2}"/>
    </joint>
  </xacro:macro>
</robot>
