    <joint name="${prefix}right_pico_joint" type="fixed">
      <origin xyz="-0.032782 0.024077 0.013155" rpy="0.33958373456889773 -0.8514219456851909 1.551281704353287" />
      <parent link="${prefix}right_base_link" />
      <child link="${prefix}right_pico_link" />
    </joint>
    <link name="${prefix}right_eef_link" />
    <joint name="${prefix}right_eef_joint" type="fixed">
      <origin xyz="0.036575 0 0.1894217" rpy="0 0 0" />
      <parent link="${prefix}right_base_link" />
      <child link="${prefix}right_eef_link" />
    </joint>
    <link name="${prefix}right_camera_link" />
