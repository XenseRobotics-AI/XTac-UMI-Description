        <geometry>
          <mesh filename="${mesh_root}/right/link2.STL" />
        </geometry>
        <material name="${prefix}right_finger" />
      </visual>
    </link>
    <joint name="${prefix}right_left_joint" type="revolute">
      <origin xyz="0.01465 0.019945 0.037" rpy="0 0 0" />
      <parent link="${prefix}right_base_link" />
      <child link="${prefix}right_left_link" />
      <axis xyz="1 0 0" />
      <limit lower="-0.5047492196767601" upper="0" effort="1" velocity="1" />
      <mimic joint="${prefix}right_right_joint" multiplier="-1" offset="0" />
