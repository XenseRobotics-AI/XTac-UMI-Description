<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Generated by scripts/generate_master_models.py; edit source URDF. Visual/kinematic only. -->
  <xacro:macro name="taccap_master_left" params="prefix:='' mesh_root:='package://taccap_master_description/meshes'">
    <material name="${prefix}left_shell">
      <color rgba="0.58 0.64 0.72 1" />
    </material>
    <material name="${prefix}left_finger">
      <color rgba="0.20 0.83 0.94 1" />
    </material>
    <link name="${prefix}left_base_link">
      <visual name="${prefix}left_body_visual">
        <origin xyz="0.02065 0 0.024785" rpy="0 -1.5707963267948966 0" />
        <geometry>
          <mesh filename="${mesh_root}/left/base_link.STL" />
        </geometry>
        <material name="${prefix}left_shell" />
      </visual>
      <visual name="${prefix}left_body_aux_visual">
        <origin xyz="0.0364999715519367 0 0.189421788170065" rpy="1.5707963267948966 0 -1.5707963267948966" />
        <geometry>
          <mesh filename="${mesh_root}/left/link4.STL" />
        </geometry>
        <material name="${prefix}left_shell" />
      </visual>
    </link>
    <link name="${prefix}left_right_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 -1.5707963267948966 0" />
        <geometry>
          <mesh filename="${mesh_root}/left/link1.STL" />
        </geometry>
        <material name="${prefix}left_finger" />
      </visual>
    </link>
    <joint name="${prefix}left_right_joint" type="revolute">
      <origin xyz="0.01464997155193993 -0.0199448287448794 0.0369999972236626" rpy="0 0 0" />
      <parent link="${prefix}left_base_link" />
      <child link="${prefix}left_right_link" />
      <axis xyz="1 0 0" />
      <limit lower="0" upper="0.5047492196767601" effort="1" velocity="1" />
    </joint>
    <link name="${prefix}left_left_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 -1.5707963267948966 0" />
        <geometry>
          <mesh filename="${mesh_root}/left/link2.STL" />
        </geometry>
        <material name="${prefix}left_finger" />
      </visual>
    </link>
    <joint name="${prefix}left_left_joint" type="revolute">
      <origin xyz="0.01465 0.019955 0.037" rpy="0 0 0" />
      <parent link="${prefix}left_base_link" />
      <child link="${prefix}left_left_link" />
      <axis xyz="1 0 0" />
      <limit lower="-0.5047492196767601" upper="0" effort="1" velocity="1" />
      <mimic joint="${prefix}left_right_joint" multiplier="-1" offset="0" />
    </joint>
    <link name="${prefix}left_pico_link">
      <visual>
        <geometry>
          <mesh filename="${mesh_root}/left/link3.STL" />
        </geometry>
        <material name="${prefix}left_shell" />
      </visual>
    </link>
    <joint name="${prefix}left_pico_joint" type="fixed">
      <origin xyz="-0.032054 -0.023651 0.014053" rpy="2.8750023051296245 0.8599287316238766 -1.9703474638774119" />
      <parent link="${prefix}left_base_link" />
      <child link="${prefix}left_pico_link" />
    </joint>
    <link name="${prefix}left_eef_link" />
    <joint name="${prefix}left_eef_joint" type="fixed">
      <origin xyz="0.036575 0 0.1894217" rpy="0 0 0" />
      <parent link="${prefix}left_base_link" />
      <child link="${prefix}left_eef_link" />
    </joint>
    <link name="${prefix}left_camera_link" />
    <joint name="${prefix}left_camera_joint" type="fixed">
      <origin xyz="-0.02285 0 0.04975" rpy="0 0 0" />
      <parent link="${prefix}left_base_link" />
      <child link="${prefix}left_camera_link" />
    </joint>
    <link name="${prefix}left_camera_optical_link" />
    <joint name="${prefix}left_camera_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 -1.5707963267948966" />
      <parent link="${prefix}left_camera_link" />
      <child link="${prefix}left_camera_optical_link" />
