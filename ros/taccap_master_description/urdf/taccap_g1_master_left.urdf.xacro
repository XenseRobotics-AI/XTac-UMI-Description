    <link name="${prefix}left_follower_link" />
    <joint name="${prefix}left_follower_joint" type="fixed">
      <origin xyz="0 0 -0.0115" rpy="0 0 0" />
      <parent link="${prefix}left_base_link" />
      <child link="${prefix}left_follower_link" />
    </joint>
  </xacro:macro>
</robot>
