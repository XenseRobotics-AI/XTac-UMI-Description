<?xml version="1.0"?>
<!-- Hand-written standalone wrapper for visualization; NOT generated by
     scripts/generate_master_models.py. right.urdf.xacro defines a macro rather
     than a robot, so robot_state_publisher needs this instantiation. The
     include is relative, so it resolves both in this repository and in the
     installed ROS share. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="taccap_master_right">
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="mesh_root" default="package://taccap_master_description/meshes"/>
  <xacro:include filename="taccap_g1_master_right.urdf.xacro"/>
  <xacro:taccap_master_right prefix="$(arg prefix)" mesh_root="$(arg mesh_root)"/>
</robot>
