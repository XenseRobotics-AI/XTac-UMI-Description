#usda 1.0
(
    defaultPrim = "Master"
    doc = "Generated TacCap master visual asset; no rigid-body physics."
    endTimeCode = 120
    framesPerSecond = 60
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def Xform "Master" (
    prepend references = @./right.usda@
)
{
    over "right_base_link"
    {
        over "right_right_link"
        {
            float xformOp:rotateX:opening.timeSamples = {
                0: 0,
                60: 28.92,
                120: 0,
            }
        }

        over "right_left_link"
        {
            float xformOp:rotateX:opening.timeSamples = {
                0: 0,
                60: -28.92,
                120: 0,
            }
        }
    }
}

